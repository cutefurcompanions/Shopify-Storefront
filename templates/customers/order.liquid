<section class="cfc-page-section"><div class="cfc-container cfc-account"><a class="cfc-link" href="{{ routes.account_url }}">Back to account</a><h1>Order {{ order.name | escape }}</h1><p>{{ order.created_at | date: '%B %d, %Y' }}</p>{% if order.cancelled %}<p>Cancelled: {{ order.cancel_reason_label | escape }}</p>{% endif %}{% for item in order.line_items %}<article class="cfc-order-card"><h2>{{ item.title | escape }}</h2><p>{{ item.quantity }} × {{ item.final_price | money }} · {{ item.final_line_price | money }}</p>{% for allocation in item.line_level_discount_allocations %}<p>{{ allocation.discount_application.title | escape }} −{{ allocation.amount | money }}</p>{% endfor %}{% if item.fulfillment %}<p>{{ item.fulfillment.created_at | date: '%B %d, %Y' }}{% if item.fulfillment.tracking_url %} · <a href="{{ item.fulfillment.tracking_url }}">Track shipment</a>{% endif %}</p>{% endif %}</article>{% endfor %}<p>Subtotal: {{ order.line_items_subtotal_price | money }}</p>{% for discount in order.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}{% for shipping in order.shipping_methods %}<p>{{ shipping.title | escape }}: {{ shipping.price | money }}</p>{% endfor %}{% for tax in order.tax_lines %}<p>{{ tax.title | escape }}: {{ tax.price | money }}</p>{% endfor %}<p>Total: {{ order.total_net_amount | money_with_currency }}</p><div class="cfc-address-grid"><div class="cfc-glass-panel"><h2>Billing address</h2>{{ order.billing_address | format_address }}</div><div class="cfc-glass-panel"><h2>Shipping address</h2>{{ order.shipping_address | format_address }}</div></div></div></section>