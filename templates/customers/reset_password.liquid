<section class="cfc-auth"><div class="cfc-auth__inner"><header class="cfc-auth__heading"><h1>Reset password</h1><p>Make yourself at home.</p></header><div class="cfc-auth__panel cfc-glass-panel">{% form 'reset_customer_password', class: 'cfc-contact' %}{{ form.errors | default_errors }}<label>New password<input name="customer[password]" type="password" autocomplete="new-password" required></label><label>Confirm password<input name="customer[password_confirmation]" type="password" autocomplete="new-password" required></label><button class="cfc-button" type="submit">Reset password</button>{% endform %}</div></div></section>
