<section class="cfc-page-section"><div class="cfc-container cfc-account">
<header class="cfc-account-hero cfc-glass-panel"><div class="cfc-avatar" aria-hidden="true">{{ customer.first_name | slice: 0 | upcase | escape }}{{ customer.last_name | slice: 0 | upcase | escape }}</div><div><h1>{{ customer.name | escape }}</h1><p>{{ customer.email | escape }}</p></div><div class="cfc-account-actions"><a class="cfc-button cfc-button--secondary" href="#orders">My orders</a><a class="cfc-link" href="{{ routes.account_logout_url }}">Sign out</a></div></header>
<div class="cfc-account-grid"><aside class="cfc-account-sidebar"><div class="cfc-glass-panel"><h2 class="cfc-eyebrow">Personal details</h2><p>{{ customer.name | escape }}<br>{{ customer.email | escape }}</p>{% if customer.default_address %}{{ customer.default_address | format_address }}{% endif %}<a class="cfc-link" href="{{ routes.account_addresses_url }}">Manage addresses →</a></div><div class="cfc-glass-panel"><h2 class="cfc-eyebrow">Quick links</h2><a href="{{ routes.all_products_collection_url }}">Explore the collection →</a><a href="{{ routes.cart_url }}">View cart →</a>{% assign support = settings.order_support_page | default: pages['order-support'] %}{% assign contact = settings.contact_page | default: pages['talk-to-us'] | default: pages['contact'] %}{% if support != blank %}<a href="{{ support.url }}">Order support →</a>{% endif %}{% if contact != blank %}<a href="{{ contact.url }}">Talk to us →</a>{% endif %}</div></aside>
<div id="orders"><div class="cfc-orders-heading"><h2>My orders</h2><span>{{ customer.orders_count }} total</span></div>{% paginate customer.orders by 20 %}{% for order in customer.orders %}<article class="cfc-order-card"><h3><a href="{{ order.customer_url }}">Order {{ order.name | escape }} ↗</a></h3><p>{{ order.created_at | date: '%B %d, %Y' }}</p><p><span class="cfc-order-status">{{ order.fulfillment_status_label | escape }}</span> · {{ order.financial_status_label | escape }}</p><strong>{{ order.total_net_amount | money_with_currency }}</strong></article>{% else %}<div class="cfc-empty-state"><span class="cfc-empty-icon" aria-hidden="true">{% render 'icon', name: 'bag' %}</span><h2>No orders yet.</h2><p>Find a piece of the natural world to make your own.</p><a class="cfc-button" href="{{ routes.all_products_collection_url }}">Explore the Collection →</a></div>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}</div></div>
</div></section>
