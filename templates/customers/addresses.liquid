<section class="cfc-page-section"><div class="cfc-container cfc-account"><h1>Your addresses</h1><p><a href="{{ routes.account_url }}">Back to account</a></p>{% paginate customer.addresses by 10 %}{% for address in customer.addresses %}<article class="cfc-glass-panel cfc-address-card">{{ address | format_address }}{% if address == customer.default_address %}<p>Default address</p>{% endif %}<details><summary>Edit address</summary>{% form 'customer_address', address, class: 'cfc-contact' %}{{ form.errors | default_errors }}{% render 'address-fields', form: form, address: address %}<button class="cfc-button">Save address</button>{% endform %}</details><form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button class="cfc-link-button" type="submit">Delete address</button></form></article>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}<details class="cfc-glass-panel cfc-address-card"><summary>Add address</summary>{% form 'customer_address', customer.new_address, class: 'cfc-contact' %}{{ form.errors | default_errors }}{% render 'address-fields', form: form, address: customer.new_address %}<button class="cfc-button">Add address</button>{% endform %}</details><script src="{{ 'addresses.js' | asset_url }}" defer></script></div></section>