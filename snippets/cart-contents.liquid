<div data-cfc-cart-content data-count="{{ cart.item_count }}">
{% if cart.empty? %}<div class="cfc-empty-state"><span class="cfc-empty-icon" aria-hidden="true">{% render 'icon', name: 'bag' %}</span><h2>Your cart is empty.</h2><p>Explore the collection and find your next piece.</p><a class="cfc-button" href="{{ routes.all_products_collection_url }}">Explore the Collection →</a></div>
{% else %}
<form action="{{ routes.cart_url }}" method="post" class="cfc-cart-native" data-cfc-cart-form>
<div class="cfc-cart-lines">{% for item in cart.items %}<article class="cfc-cart-line">
<a href="{{ item.url }}" class="cfc-cart-line__media">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,360', sizes: '120px', alt: item.product.title }}{% endif %}</a>
<div class="cfc-cart-line__info"><div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% unless first_char == '_' or property.last == blank %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}
{% for allocation in item.line_level_discount_allocations %}<p>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</p>{% endfor %}</div>
<div class="cfc-cart-line__bottom"><label>Qty<input type="number" name="updates[]" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %} inputmode="numeric" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}" data-cfc-cart-key="{{ item.key | escape }}" required></label><span>{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s> {% endif %}{{ item.final_line_price | money }}</span></div><a href="{{ item.url_to_remove }}" data-cfc-remove="{{ item.key | escape }}">Remove</a></div></article>{% endfor %}</div>
<div class="cfc-cart-summary"><h2>Order summary</h2><label>Order note<textarea name="note">{{ cart.note | escape }}</textarea></label>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Shipping and taxes are calculated at checkout.</p><button type="submit" name="checkout" class="cfc-button">Checkout securely</button><button type="submit" name="update" class="cfc-link-button">Update cart</button></div></form>{% endif %}</div>
