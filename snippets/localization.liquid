{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
{% form 'localization', class: 'cfc-localization' %}
{% if localization.available_countries.size > 1 %}<label>Country / currency<select name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} · {{ country.currency.iso_code }}</option>{% endfor %}</select></label>{% endif %}
{% if localization.available_languages.size > 1 %}<label>Language<select name="locale_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}</select></label>{% endif %}<button type="submit" class="cfc-button">Update</button>
{% endform %}{% endif %}
