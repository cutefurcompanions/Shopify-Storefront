{% if template.name == 'product' and product != blank %}
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ product.title | escape }} — {{ shop.name | escape }}">
  <meta property="og:description" content="{{ product.description | strip_html | truncate: 155 | escape }}">
  {% if product.featured_image %}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1600 }}">
  {% endif %}
{% elsif collection != blank %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ collection.title | escape }} — {{ shop.name | escape }}">
{% else %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
{% endif %}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
{% if settings.social_image != blank %}
  <meta property="og:image" content="https:{{ settings.social_image | image_url: width: 1600 }}">
{% endif %}

{% if request.page_type == 'product' %}<script type="application/ld+json">{{ product | structured_data }}</script>{% endif %}
