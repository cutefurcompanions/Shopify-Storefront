<label>First name<input name="address[first_name]" autocomplete="given-name" value="{{ form.first_name | escape }}"></label><label>Last name<input name="address[last_name]" autocomplete="family-name" value="{{ form.last_name | escape }}"></label><label>Company<input name="address[company]" autocomplete="organization" value="{{ form.company | escape }}"></label><label>Address<input name="address[address1]" autocomplete="address-line1" value="{{ form.address1 | escape }}" required></label><label>Apartment, suite, etc.<input name="address[address2]" autocomplete="address-line2" value="{{ form.address2 | escape }}"></label><label>City<input name="address[city]" autocomplete="address-level2" value="{{ form.city | escape }}" required></label><label>Country<select name="address[country]" data-cfc-country data-default="{{ form.country | escape }}" autocomplete="country">{{ all_country_option_tags }}</select></label><label>State / province<select name="address[province]" data-cfc-province data-default="{{ form.province | escape }}" autocomplete="address-level1"></select></label><noscript><label>State / province<input name="address[province]" value="{{ form.province | escape }}"></label></noscript><label>Postal code<input name="address[zip]" autocomplete="postal-code" value="{{ form.zip | escape }}"></label><label>Phone<input type="tel" name="address[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></label><label>{{ form.set_as_default_checkbox }} Set as default</label>