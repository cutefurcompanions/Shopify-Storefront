<section class="cfc-section" data-cfc-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit=4&amp;intent=related">
{% if recommendations.performed and recommendations.products_count > 0 %}<div class="cfc-container"><div class="cfc-section__head"><h2>You may also like</h2></div><div class="cfc-product-grid">{% for recommended in recommendations.products %}{% render 'product-card', product: recommended %}{% endfor %}</div></div>{% endif %}
</section>{% schema %}{"name":"Product recommendations","settings":[]}{% endschema %}