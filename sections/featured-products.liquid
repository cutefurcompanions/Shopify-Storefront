<section class="cfc-section cfc-section--tight">
  <div class="cfc-container">
    <div class="cfc-section__head">
      <div>
        <p class="cfc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.link != blank %}
        <a class="cfc-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {% else %}
        <a class="cfc-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>

    {% assign source_collection = section.settings.collection %}
    {% if source_collection == blank %}
      {% assign source_products = collections['frontpage'].products %}
    {% else %}
      {% assign source_products = source_collection.products %}
    {% endif %}

    {% if source_products != blank %}
      <div class="cfc-product-grid">
        {% for product in source_products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cfc-empty-state">
        <h3>A new landscape is taking shape.</h3><p>Our next pieces will appear here. Explore the collections for more.</p>{% if request.design_mode %}<p>Choose a populated collection in this section’s settings.</p>{% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CFC — Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured pieces" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the long look." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [
    { "name": "CFC — Featured products" }
  ]
}
{% endschema %}
