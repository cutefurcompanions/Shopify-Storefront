<section class="cfc-page-section"><div class="cfc-container"><h1>{{ blog.title | escape }}</h1>{% paginate blog.articles by 12 %}<div class="cfc-category-grid">{% for article in blog.articles %}<article class="cfc-category-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}{% endif %}<div class="cfc-category-card__body"><h2>{{ article.title | escape }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate: 150 | escape }}</p></div></a></article>{% else %}<p>Stories are on their way.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div></section>{% schema %}{"name":"Journal"}{% endschema %}