{% assign about = settings.about_page | default: pages['about'] | default: pages['about-us'] %}
{% assign contact = settings.contact_page | default: pages['talk-to-us'] | default: pages['contact'] %}
{% assign support = settings.order_support_page | default: pages['order-support'] %}
{% assign returns = settings.returns_page | default: pages['returns'] %}
<footer class="cfc-footer">
  <div class="cfc-footer__inner">
    <div class="cfc-footer__grid">
      <div><h2 class="cfc-eyebrow">Information</h2><div class="cfc-footer__links">{% if about != blank %}<a href="{{ about.url }}">About</a>{% endif %}{% if returns != blank %}<a href="{{ returns.url }}">Returns &amp; exchanges</a>{% elsif shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Returns &amp; exchanges</a>{% endif %}<a href="{{ routes.all_products_collection_url }}">All pieces</a>{% render 'menu-links', menu: section.settings.information_menu %}</div></div>
      <div><h2 class="cfc-eyebrow">Account</h2><div class="cfc-footer__links">{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_login_url }}">Sign in</a><a href="{{ routes.account_url }}">My account &amp; orders</a>{% endif %}<a href="{{ routes.cart_url }}">Your cart</a></div></div>
      <div><h2 class="cfc-eyebrow">Support</h2><div class="cfc-footer__links">{% if contact != blank %}<a href="{{ contact.url }}">Talk to us</a>{% endif %}{% if support != blank %}<a href="{{ support.url }}">Order support</a>{% endif %}{% render 'menu-links', menu: section.settings.support_menu %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div></div>
      <div><h2 class="cfc-eyebrow">Stay in touch</h2><div class="cfc-footer__links">{% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram ↗</a>{% endif %}{% if settings.pinterest_url != blank %}<a href="{{ settings.pinterest_url }}" target="_blank" rel="noopener">Pinterest ↗</a>{% endif %}{% if settings.youtube_url != blank %}<a href="{{ settings.youtube_url }}" target="_blank" rel="noopener">YouTube ↗</a>{% endif %}{% if contact != blank %}<a href="{{ contact.url }}">Say hello →</a>{% else %}<span>We give you the biome to wear.</span>{% endif %}</div></div>
    </div>
    {% render 'localization' %}
    <div class="cfc-footer__bottom"><p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p><div class="cfc-payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "information_menu",
      "label": "Additional information links"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Additional support links"
    }
  ]
}
{% endschema %}
