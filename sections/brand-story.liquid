<section class="cfc-section"><div class="cfc-container cfc-feature-panel"><div><p class="cfc-eyebrow">CuteFurCompanions</p><h2>{{ section.settings.heading | escape }}</h2><div class="cfc-richtext">{{ section.settings.text }}</div></div>{% if section.settings.link != blank %}<a class="cfc-button" href="{{ section.settings.link }}">Our story</a>{% endif %}</div></section>
{% schema %}{"name":"Brand story","settings":[{"type":"text","id":"heading","label":"Heading","default":"Look closer. Wear what you find."},{"type":"richtext","id":"text","label":"Text","default":"<p>A silhouette on the ice. A line of distant peaks. A flower close to the ground. Our collections take their cues from wildlife, landscapes and flora, starting in the Arctic.</p>"},{"type":"url","id":"link","label":"About page"}],"presets":[{"name":"Brand story"}]}{% endschema %}
