<article class="cfc-page-section"><div class="cfc-container cfc-narrow"><a class="cfc-link" href="{{ blog.url }}">{{ blog.title | escape }}</a><h1>{{ article.title | escape }}</h1><p>{{ article.published_at | date: '%B %d, %Y' }}</p>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '750,1100,1600', sizes: '100vw', alt: article.title }}{% endif %}<div class="cfc-richtext">{{ article.content }}</div>{% if blog.comments_enabled? %}<h2>Comments</h2>{% paginate article.comments by 20 %}{% for comment in article.comments %}<article><h3>{{ comment.author | escape }}</h3><p>{{ comment.created_at | date: '%B %d, %Y' }}</p><p>{{ comment.content | strip_html | escape }}</p></article>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}{% form 'new_comment', article, class: 'cfc-contact' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Thank you. Your comment was submitted and may await moderation.</p>{% endif %}<label>Name<input name="comment[author]" value="{{ form.author | escape }}" autocomplete="name" required></label><label>Email<input type="email" name="comment[email]" value="{{ form.email | escape }}" autocomplete="email" required></label><label>Comment<textarea name="comment[body]" required>{{ form.body | escape }}</textarea></label><button class="cfc-button">Submit comment</button>{% endform %}{% endif %}</div></article>{% schema %}{"name":"Article"}{% endschema %}