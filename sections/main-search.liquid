<section class="cfc-page-section">
  <div class="cfc-container">
    <div class="cfc-search-heading cfc-search-panel">
      <p class="cfc-eyebrow">Browse the store</p>
      <h1>Find your piece</h1>
      <p>Browse the live collections directly. Search is unavailable while the catalogue is being organised, so it never returns irrelevant pieces.</p>
    </div>
    <nav class="cfc-search-browse" aria-label="Browse collections">{% render 'category-navigation' %}<a href="{{ routes.all_products_collection_url }}">Shop all</a></nav>
  </div>
</section>
{% schema %}
{
  "name": "CFC browse"
}
{% endschema %}