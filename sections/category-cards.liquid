<section class="cfc-section">
  <div class="cfc-container">
    <div class="cfc-section__head">
      <div>
        <p class="cfc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.intro != blank %}<p class="cfc-section__intro">{{ section.settings.intro | escape }}</p>{% endif %}
    </div>

    <div class="cfc-category-grid">
      {% for block in section.blocks %}
        {% assign chosen = block.settings.collection %}
        <a class="cfc-category-card" href="{{ chosen.url | default: block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="cfc-category-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.title }}
            {% elsif chosen.featured_image %}
              {{ chosen.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', sizes: '(min-width: 990px) 33vw, 100vw', alt: chosen.title }}
            {% endif %}
            <div class="cfc-category-card__veil"></div>
          </div>
          <div class="cfc-category-card__body">
            <span class="cfc-eyebrow">{{ block.settings.eyebrow | escape }}</span>
            <h3>{{ block.settings.title | default: chosen.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
            <span class="cfc-link">{{ block.settings.link_label | escape }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CFC — Categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three expressions of the North." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your side of the wild." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Wildlife, landscapes and flora share one collection, one atmosphere and one quiet visual language." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wildlife" },
        { "type": "text", "id": "title", "label": "Title", "default": "Wildlife" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Foxes, owls, whales and the animals of the far north." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore →" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Fallback link" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CFC — Wildlife / Landscape / Flora",
      "blocks": [
        { "type": "category", "settings": { "eyebrow": "01", "title": "Wildlife", "text": "Foxes, owls, whales and the animals of the far north." } },
        { "type": "category", "settings": { "eyebrow": "02", "title": "Landscape", "text": "Glaciers, fjords, sea ice and endless open sky." } },
        { "type": "category", "settings": { "eyebrow": "03", "title": "Flora", "text": "Mosses, lichens and the small flowers of the tundra." } }
      ]
    }
  ]
}
{% endschema %}
