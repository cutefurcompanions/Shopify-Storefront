<section class="cfc-page-section"><div class="cfc-container cfc-narrow"><h1>{{ page.title | escape }}</h1><div class="cfc-richtext">{{ page.content }}</div>{% for block in section.blocks %}<details class="cfc-product-details" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="cfc-richtext">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>{% schema %}{"name":"FAQ","blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Your question"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Add your store’s answer.</p>"}]}],"presets":[{"name":"FAQ"}]}{% endschema %}